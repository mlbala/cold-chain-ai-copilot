# Cold Chain Control Tower & AI Copilot — environment template.
# Copy to `.env` and fill in real values. Never commit `.env`.

# --- Runtime -----------------------------------------------------------------
# APP_ENV: development | production. LOG_FORMAT: console | json.
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=console
HOST=127.0.0.1
PORT=8000

# --- Aiven PostgreSQL --------------------------------------------------------
# Copy host, port, database, user and password from the Aiven console (service Overview).
# The admin user (avnadmin) is used only by `setup-rbac`, `ingest-db`, and the audit viewer.
AIVEN_HOST=your-service.aivencloud.com
AIVEN_PORT=12345
AIVEN_DB_NAME=defaultdb
# require | verify-ca | verify-full
AIVEN_SSLMODE=require
AIVEN_ADMIN_USER=avnadmin
AIVEN_ADMIN_PASSWORD=CHANGE_ME
# The agent user MUST be usr_fde_ro. Choose a password (12+ chars); `setup-rbac` creates the
# role with it.
AIVEN_AGENT_RO_USER=usr_fde_ro
AIVEN_AGENT_RO_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Alternative to the fields above (used only when AIVEN_HOST is unset): full service URIs.
# AIVEN_ADMIN_DB_URI=postgres://avnadmin:PASSWORD@HOST:PORT/defaultdb?sslmode=require
# AIVEN_AGENT_RO_DB_URI=postgres://usr_fde_ro:PASSWORD@HOST:PORT/defaultdb?sslmode=require

# --- DeepSeek hybrid router (OpenAI-compatible API) --------------------------
DEEPSEEK_API_KEY=sk-CHANGE_ME
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_FLASH_MODEL=deepseek-chat
DEEPSEEK_PRO_MODEL=deepseek-reasoner
# USD per 1M tokens. Output prices default to 0 (cost readouts then cover input tokens only).
FLASH_INPUT_PRICE_PER_M=0.15
PRO_INPUT_PRICE_PER_M=0.66
FLASH_OUTPUT_PRICE_PER_M=0
PRO_OUTPUT_PRICE_PER_M=0
# Optional: price of prefix-cache hits per 1M tokens. Leave commented out to bill cache hits
# at the full input price (conservative). Set them from your DeepSeek pricing page.
# FLASH_CACHED_INPUT_PRICE_PER_M=0.015
# PRO_CACHED_INPUT_PRICE_PER_M=0.066

# --- Retrieval (OpenAI embeddings + Pinecone Serverless) ---------------------
OPENAI_API_KEY=sk-CHANGE_ME
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
PINECONE_API_KEY=pcsk_CHANGE_ME
PINECONE_INDEX_NAME=fde-sop-index-openai
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_NAMESPACE=sops

# --- Admin -------------------------------------------------------------------
# Gates POST /api/v1/audit/logs and POST /api/v1/audit/rbac-test (X-Admin-Password header).
ADMIN_AUDIT_PASSWORD=CHANGE_ME_LONG_RANDOM_STRING

# --- Agent guardrails --------------------------------------------------------
SQL_MAX_FIX_ATTEMPTS=2
SQL_ROW_LIMIT=200
SQL_STATEMENT_TIMEOUT_MS=5000
AGENT_MAX_TOOL_CALLS=6
